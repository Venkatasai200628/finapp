{
  "expo": {
    "name": "fin",
    "slug": "fin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "finapp",
    "backgroundColor": "#0B0F14",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.karnatipraveen.fin",
      "versionCode": 2,
      "adaptiveIcon": {
        "backgroundColor": "#05090c",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "READ_SMS",
        "RECEIVE_SMS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-splash-screen",
      "expo-secure-store"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d071043a-e56d-4a12-9225-738f87b5582e"
      }
    },
    "owner": "venkatasai2006"
  }
}
