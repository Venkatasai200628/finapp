# Points the app at the real-time backend (see backend/README.md).
# Leave unset to run entirely on-device with the local fallback simulation.
#
# On a physical phone (Expo Go), "localhost" won't reach your laptop — use
# your machine's LAN IP instead, e.g. http://192.168.1.23:4000
EXPO_PUBLIC_BACKEND_URL=http://localhost:4000
