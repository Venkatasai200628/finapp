# Server
PORT=4000

# How often the built-in simulator emits a transaction (ms), while there is
# no real data source connected. Ignored once Account Aggregator is wired up.
SIMULATOR_INTERVAL_MS=8000

# --- Account Aggregator (Setu sandbox) ---
# Sign up for a free sandbox account at https://bridge.setu.co (Data > Account
# Aggregator product) to get these. Leave blank to keep running on the
# built-in simulator instead of real bank data.
AA_CLIENT_ID=
AA_CLIENT_SECRET=
AA_BASE_URL=https://fiu-sandbox.setu.co
